pipeline {
agent any


tools {
    maven 'Maven-3.9.16'
}

stages {

    stage('Checkout') {
        steps {
            checkout scm
        }
    }

    stage('Build') {
        steps {
            bat 'mvn clean compile'
        }
    }

    stage('Test') {
        steps {
            bat 'mvn test'
        }
    }

    stage('Package') {
        steps {
            bat 'mvn package -DskipTests'
        }
    }

    stage('Deploy') {
        steps {
            bat 'java -jar target\\java-calculator-1.0-SNAPSHOT.jar'
        }
    }
}


}
